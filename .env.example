# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Phase 1: globe and map ---------------------------------------------
# Public token from account.mapbox.com > Tokens (starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Supabase (optional in phase 1, required from phase 2) ---------------
# Project Settings > API. Without these, scores come from data/seed/zone-state.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4: Stripe (test mode only) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
