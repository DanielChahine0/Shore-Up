# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Phase 1: globe and map ---------------------------------------------
# Public token from account.mapbox.com > Tokens (starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Supabase (optional in phase 1, required from phase 2) ---------------
# URL: Project Settings > Data API. Keys: Project Settings > API Keys.
# Without these, scores come from data/seed/zone-state.json.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (optional). Provisioned by Stripe Projects, which writes these to .env:
#   stripe projects add posthog/analytics && stripe projects env --pull
# Events go through /api/track, so the browser never talks to PostHog. Leave empty to turn analytics off.
POSTHOG_ANALYTICS_HOST=
POSTHOG_ANALYTICS_API_KEY=
